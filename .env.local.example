# ─── Acoustic Chronometer — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Supabase (Free Tier) ──────────────────────────────────────────────────────
# Get these from: https://supabase.com → Project → Settings → API

# Public (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private (server-side API routes only — NEVER expose in browser)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Freesound API (Free — No Credit Card) ────────────────────────────────────
# Get a free key at: https://freesound.org/apiv2/apply/
# Takes ~1 minute, instant approval. Used only by the populate script (server-side).
FREESOUND_API_KEY=your-freesound-api-key-here

# ── Optional: Admin page password ────────────────────────────────────────────
# Simple password for the /admin puzzle upload page
ADMIN_PASSWORD=change-me-before-production

# ── Notes ─────────────────────────────────────────────────────────────────────
# Audio files: Upload to Supabase Storage → "audio" bucket (set as public)
# Free tier includes: 500MB DB, 1GB Storage, 50k monthly active users
# No credit card required for free tier.
#
# Deployment: Push to GitHub → Connect to Vercel (free tier)
# Add these env vars in Vercel: Settings → Environment Variables
